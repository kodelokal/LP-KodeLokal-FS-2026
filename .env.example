# Neon PostgreSQL connection string (configure in Vercel Environment Variables)
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require"

# Random 32+ char secret for cookie signing / session security
AUTH_SECRET="replace-with-a-strong-random-secret-key"

# Canonical site URL
NEXT_PUBLIC_SITE_URL="https://kodelokal.store"
